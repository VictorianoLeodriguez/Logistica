@model WebApplication1.Models.Caminhao

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Cadastrar Caminhão</h2>
    <hr />

    @if (ViewBag.Message != null)
    {
    <div class="alert alert-success">@ViewBag.Message</div>
    }

    @using (Html.BeginForm("Cadastro", "Caminhao", FormMethod.Post))
    {
    <div class="form-group mb-3">
        <label>Placa</label>
        @Html.TextBoxFor(m => m.CMHO_PLA, new { @class = "form-control", placeholder = "ABC1D23" })
    </div>

    <div class="form-group mb-3">
        <label>Modelo</label>
        @Html.TextBoxFor(m => m.CMHO_MDL, new { @class = "form-control", placeholder = "Modelo do caminhão" })
    </div>

    @Html.HiddenFor(m => m.CMHO_AIC)

    <button class="btn btn-success" type="submit">Salvar</button>
    <a href="@Url.Action("Lista", "Caminhao")" class="btn btn-secondary ms-2">Voltar</a>
    }
</div>
