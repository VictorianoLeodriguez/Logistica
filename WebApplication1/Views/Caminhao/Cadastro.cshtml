@model WebApplication1.Models.Caminhao

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-content container mt-4">
    <h2>Cadastrar Caminhão</h2>
    <hr />

    @if (ViewBag.Message != null)
    {
    <div class="alert alert-success">@ViewBag.Message</div>
    }

    @using (Html.BeginForm("Cadastro", "Caminhao", FormMethod.Post))
    {
    <div class="form-group mb-3">
        <label>Placa</label>
        @Html.TextBoxFor(m => m.CMHO_PLA, new { @class = "form-control", placeholder = "ABC1D23" })
    </div>

    <div class="form-group mb-3">
        <label>Modelo</label>
        @Html.TextBoxFor(m => m.CMHO_MDL, new { @class = "form-control", placeholder = "Modelo do caminhão" })
    </div>

    <div class="form-group">
        <label>ID do Motorista</label>
        <input type="number" name="USR_AIC" class="form-control" required />
    </div>

    @Html.HiddenFor(m => m.CMHO_AIC)

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Salvar</button>
        <a href="@Url.Action("Lista", "Caminhao")" class="btn btn-secondary">Voltar</a>
    </div>
    }
</div>
