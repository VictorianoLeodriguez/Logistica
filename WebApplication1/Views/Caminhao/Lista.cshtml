@model List<WebApplication1.Models.Caminhao>

<div class="main-content container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="row">
            <a href="@Url.Action("Cadastro", "Caminhao")" class="btn btn-success">
                <i class="bi bi-plus-lg"></i> Novo Caminhão
            </a>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
    <div class="table-responsive shadow rounded">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Placa</th>
                    <th scope="col">Modelo</th>
                    <th scope="col" class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                    {
                <tr data-id="@item.CMHO_AIC">
                    <td>@item.CMHO_AIC</td>
                    <td>@item.CMHO_PLA</td>
                    <td>@item.CMHO_MDL</td>
                    <td class="text-center">
                        <div class="col-md-4">
                            <a class="btn btn-sm btn-primary me-1">
                               
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href='@Url.Action("Excluir", "Caminhao", new { id = item.CMHO_AIC })'
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Deseja realmente excluir este Registro de Caminhão?');">
                                
                            </a>
                        </div>
                    </td>
                </tr>
                    }
            </tbody>
        </table>
    </div>
    }
    else
    {
    <div class="alert alert-info mt-3 text-center shadow-sm" role="alert">
        Nenhum Caminhão cadastrado.
    </div>
    }
</div>
