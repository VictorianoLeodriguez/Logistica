@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Simulada</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }


        .card {
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .circle-chart {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: conic-gradient(#0d6efd 0% 70%, #e9ecef 0 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 20px;
            margin: auto;
        }

        .bar-chart {
            display: flex;
            align-items: flex-end;
            height: 80px;
            gap: 5px;
            margin-top: 10px;
        }

        .bar {
            width: 50px;
            background: #00bcd4;
            margin: 10px auto 0;
            border-radius: 5px 5px 0 0;
            transition: height 0.3s;
        }

            .bar.green {
                background-color: #198754;
            }

            .bar.orange {
                background-color: #fd7e14;
            }

            .bar.red {
                background-color: #dc3545;
            }

        .legend {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            margin-top: 5px;
        }
    </style>
</head>
<body class="p-3">
    <div class="main-content">
        <h1 class="mb-4">Bem-Vindo Motorista</h1>

        <div class="text-center mt-4">
            <img src="https://blog.imam.com.br/wp-content/uploads/2023/01/aerial-view-of-logistic-center-2021-12-09-11-03-59-utc-780x450.jpg"
                 alt="Imagem centralizada"
                 class="img-fluid rounded shadow" />
        </div>
    </div>
</body>
</html>
