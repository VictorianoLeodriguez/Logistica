@using WebApplication1.Utils

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model List<WebApplication1.Models.Entregas>

<div class="main-content container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="row">
            <a href="@Url.Action("Cadastro", "Entrega")" class="btn btn-success">
                <i class="bi bi-plus-lg"></i> Nova Entrega
            </a>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="table-responsive shadow rounded">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Motorista</th>
                        <th>Carga</th>
                        <th>Destino</th>
                        <th>Data e Hora de Registro</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {

                        <tr>
                            <td>@item.Codigo</td>
                            <td>@item.Motorista</td>
                            <td>@item.CRG_AIC</td>
                            <td>@item.Destino</td>
                            <td>@item.Data_RG.ToString("dd/MM/yyyy") @item.Hora_RG.ToString(@"hh\:mm")</td>
                            <td>@item.Status_ETG</td>
                            <td class="text-center">

                                <div class="col-md-4">
                                    <a href='@Url.Action("Excluir", "Entrega", new { id = item.Codigo })'
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Deseja realmente excluir este Registro de Entrega?');">
                                        <svg clip-rule="evenodd" fill-rule="evenodd" stroke-linejoin="round" stroke-miterlimit="2" height="15" width="15" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="m20.015 6.506h-16v14.423c0 .591.448 1.071 1 1.071h14c.552 0 1-.48 1-1.071 0-3.905 0-14.423 0-14.423zm-5.75 2.494c.414 0 .75.336.75.75v8.5c0 .414-.336.75-.75.75s-.75-.336-.75-.75v-8.5c0-.414.336-.75.75-.75zm-4.5 0c.414 0 .75.336.75.75v8.5c0 .414-.336.75-.75.75s-.75-.336-.75-.75v-8.5c0-.414.336-.75.75-.75zm-.75-5v-1c0-.535.474-1 1-1h4c.526 0 1 .465 1 1v1h5.254c.412 0 .746.335.746.747s-.334.747-.746.747h-16.507c-.413 0-.747-.335-.747-.747s.334-.747.747-.747zm4.5 0v-.5h-3v.5z" fill-rule="nonzero" /></svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
     }
    else
    {
        <div class="alert alert-info mt-3 text-center shadow-sm" role="alert">
            Nenhum Caminhão cadastrado.
        </div>
    }
</div>

